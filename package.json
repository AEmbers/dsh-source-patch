{
  "name": "dsh-source-patch",
  "version": "0.1.0",
  "description": "One-click anchored patching for the DSH desktop main process — lists, verifies, applies and reverts source patches against resources/app.asar, and exposes the same capability as the `ctx.sourcePatch` service so other plugins can declare the patches they need.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./apply.mjs": "./apply.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "files": [
    "index.js",
    "remote.js",
    "fence.js",
    "apply.mjs",
    "lib/client.js",
    "patches",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  }
}
